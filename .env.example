LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
RESTORE_IMAGE=postgres:16
MAX_BACKUP_LISTING=200
ALLOWED_BACKUP_EXTENSIONS=.sql,.dump,.backup,.tar

# MinIO
MINIO_BUCKET=
MINIO_PREFIX=
MINIO_ENDPOINT_URL=http://minio.minio.svc.cluster.local:9000
MINIO_REGION=us-east-1
MINIO_CREDENTIALS_SECRET_NAME=minio-credentials
MINIO_MC_IMAGE=minio/mc:latest
